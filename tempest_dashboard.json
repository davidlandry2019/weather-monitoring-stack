        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen, station_name, location_name, v AS air_temperature\nFROM (\n  SELECT max(time) AS last_seen, station_id, station_name, location_name, argMaxIf(air_temperature, time, air_temperature IS NOT NULL) AS v\n  FROM ${database}.tempest_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR AND air_temperature IS NOT NULL\n  GROUP BY station_id, station_name, location_name\n)\nORDER BY last_seen"
        }
      ],
      "timeFrom": "1h",
      "hideTimeOverride": true
    },
    {
      "id": 24,
      "title": "NWS Alert Details",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Minor": {
                        "color": "yellow",
                        "index": 0
                      },
                      "Moderate": {
                        "color": "orange",
                        "index": 1
                      },
                      "Severe": {
                        "color": "red",
                        "index": 2
                      },
                      "Extreme": {
                        "color": "dark-red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "city_name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "urgency"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expires"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT concat(station_name, ' (', location_name, ')') AS city_name,\n       severity, event, v_urgency AS urgency, v_expires AS expires, v_headline AS headline\nFROM (\n  SELECT station_id, station_name, location_name, event, severity,\n         argMax(urgency, time) AS v_urgency,\n         argMax(expires, time) AS v_expires,\n         argMax(headline, time) AS v_headline\n  FROM ${database}.tempest_nws_alerts\n  WHERE time >= now() - INTERVAL 30 MINUTE\n  GROUP BY station_id, station_name, location_name, event, severity\n)\nORDER BY city_name, event"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "city_name": 0,
              "severity": 1,
              "event": 2,
              "urgency": 3,
              "expires": 4,
              "headline": 5
            },
            "excludeByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Station Locations",
      "type": "geomap",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen AS time, station_id, v_station_name AS station_name, v_location_name AS location_name,\n       v_lat AS latitude, v_lon AS longitude\nFROM (\n  SELECT station_id,\n         max(time) AS last_seen,\n         argMax(station_name, time) AS v_station_name,\n         argMax(location_name, time) AS v_location_name,\n         argMaxIf(latitude, time, latitude IS NOT NULL) AS v_lat,\n         argMaxIf(longitude, time, longitude IS NOT NULL) AS v_lon\n  FROM ${database}.tempest_observations\n  WHERE time >= now() - INTERVAL 6 HOUR AND latitude IS NOT NULL AND longitude IS NOT NULL\n  GROUP BY station_id\n)"
        }
      ],
      "options": {
        "basemap": {
          "type": "default"
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "view": {
          "id": "coords",
          "lat": 39.8283,
          "lon": -98.5795,
          "zoom": 4
        },
        "layers": [
          {
            "type": "xyz",
            "name": "Precipitation (OpenWeatherMap)",
            "config": {
              "url": "https://tile.openweathermap.org/map/precipitation_new/{z}/{x}/{y}.png?appid=YOUR_OWM_API_KEY",
              "attribution": "Weather data \u00a9 OpenWeatherMap"
            },
            "opacity": 0.6
          },
          {
            "type": "markers",
            "name": "Stations",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 8
                },
                "color": {
                  "fixed": "blue"
                },
                "textConfig": {
                  "fontSize": 12
                }
              },
              "showLegend": false
            },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 1,
      "title": "Air Temperature (feels like / dew point)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "air_temperature"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feels_like"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dew_point"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "-- feels_like: standard NWS heat index (T >= 80F) plus a simple\n-- illustrative solar-radiation bonus (not a peer-reviewed term), or\n-- NWS wind chill (T <= 50F, wind >= 3 mph). Assumes imperial units.\nSELECT t, station_name, location_name,\n       v_air_temperature AS air_temperature,\n       v_dew_point AS dew_point,\n       multiIf(\n         v_air_temperature >= 80, -42.379 + 2.04901523*v_air_temperature + 10.14333127*v_rh - 0.22475541*v_air_temperature*v_rh - 0.00683783*v_air_temperature*v_air_temperature - 0.05481717*v_rh*v_rh + 0.00122874*v_air_temperature*v_air_temperature*v_rh + 0.00085282*v_air_temperature*v_rh*v_rh - 0.00000199*v_air_temperature*v_air_temperature*v_rh*v_rh + (coalesce(v_solar, 0) / 1000.0) * 8.0,\n         v_air_temperature <= 50 AND v_wind >= 3, 35.74 + 0.6215*v_air_temperature - 35.75*pow(v_wind, 0.16) + 0.4275*v_air_temperature*pow(v_wind, 0.16),\n         v_air_temperature) AS feels_like\nFROM (\n  SELECT $__timeInterval(time) AS t, station_id, station_name, location_name,\n         avg(air_temperature) AS v_air_temperature,\n         avg(dew_point) AS v_dew_point,\n         avg(relative_humidity) AS v_rh,\n         avg(wind_avg) AS v_wind,\n         avg(solar_radiation) AS v_solar\n  FROM ${database}.tempest_observations FINAL\n  WHERE $__timeFilter(time) AND station_id IN (${station_id:singlequote})\n  GROUP BY t, station_id, station_name, location_name\n)\nORDER BY t"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
