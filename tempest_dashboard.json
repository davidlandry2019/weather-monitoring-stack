      "title": "Wind Direction",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "min": 0,
          "max": 360,
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})",
          "custom": {
            "drawStyle": "points",
            "pointSize": 4,
            "lineWidth": 0,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, station_name, location_name, v_wind_direction AS wind_direction\nFROM (\n  SELECT $__timeInterval(time) AS t, station_id, station_name, location_name,\n         avg(wind_direction) AS v_wind_direction\n  FROM ${database}.tempest_observations FINAL\n  WHERE $__timeFilter(time) AND station_id IN (${station_id:singlequote})\n  GROUP BY t, station_id, station_name, location_name\n)\nORDER BY t"
        }
      ],
