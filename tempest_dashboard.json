{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "ClickHouse",
      "description": "ClickHouse datasource holding the Tempest tables",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    },
    {
      "name": "VAR_DATABASE",
      "label": "ClickHouse database",
      "description": "Database the Tempest poller writes to (CLICKHOUSE_DATABASE)",
      "type": "constant",
      "value": "tempest"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "4.0.0"
    },
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": "1.0.0"
    }
  ],
  "title": "Tempest Weather Stations",
  "uid": "tempest-weather-station",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 49,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "database",
        "label": "ClickHouse database",
        "hide": 2,
        "query": "${VAR_DATABASE}",
        "current": {
          "text": "${VAR_DATABASE}",
          "value": "${VAR_DATABASE}"
        },
        "options": [
          {
            "text": "${VAR_DATABASE}",
            "value": "${VAR_DATABASE}",
            "selected": true
          }
        ],
        "skipUrlSync": false
      },
      {
        "name": "station_id",
        "label": "Station",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${DS_CLICKHOUSE}"
        },
        "query": "SELECT station_id, concat(argMax(station_name, time), ' \u2014 ', argMax(location_name, time)) FROM ${database}.tempest_observations WHERE time >= now() - INTERVAL 30 DAY GROUP BY station_id ORDER BY station_id",
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "definition": "SELECT station_id, concat(argMax(station_name, time), ' \u2014 ', argMax(location_name, time)) FROM ${database}.tempest_observations WHERE time >= now() - INTERVAL 30 DAY GROUP BY station_id ORDER BY station_id"
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "title": "Freeze Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.station_name} (${__field.labels.location_name})",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 32
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen, station_name, location_name, v AS air_temperature\nFROM (\n  SELECT max(time) AS last_seen, station_id, station_name, location_name, argMaxIf(air_temperature, time, air_temperature IS NOT NULL) AS v\n  FROM ${database}.tempest_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR AND air_temperature IS NOT NULL\n  GROUP BY station_id, station_name, location_name\n)\nORDER BY last_seen"
        }
      ],
      "timeFrom": "1h",
      "hideTimeOverride": true
    },
    {
      "id": 21,
      "title": "High Wind Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "displayName": "${__field.labels.station_name} (${__field.labels.location_name})",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen, station_name, location_name, v AS wind_gust\nFROM (\n  SELECT max(time) AS last_seen, station_id, station_name, location_name, argMaxIf(wind_gust, time, wind_gust IS NOT NULL) AS v\n  FROM ${database}.tempest_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR AND wind_gust IS NOT NULL\n  GROUP BY station_id, station_name, location_name\n)\nORDER BY last_seen"
        }
      ],
      "timeFrom": "1h",
      "hideTimeOverride": true
    },
    {
      "id": 22,
