      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.station_name} (${__field.labels.location_name})",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 32
              },
              {
                "color": "orange",
