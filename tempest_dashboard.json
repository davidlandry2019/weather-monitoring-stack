          "max": 100,
          "min": 0,
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": []
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, station_name, location_name, v_relative_humidity AS relative_humidity\nFROM (\n  SELECT $__timeInterval(time) AS t, station_id, station_name, location_name,\n         avg(relative_humidity) AS v_relative_humidity\n  FROM ${database}.tempest_observations FINAL\n  WHERE $__timeFilter(time) AND station_id IN (${station_id:singlequote})\n  GROUP BY t, station_id, station_name, location_name\n)\nORDER BY t"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
