{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB datasource pointing at your Tempest bucket",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": "1.0.0"
    }
  ],
  "title": "Tempest Weather Stations",
  "uid": "tempest-weather-station",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 33,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "station_id",
        "label": "Station",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUXDB}"
        },
        "query": "from(bucket: \"tempest\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r._field == \"latitude\")\n  |> group(columns: [\"station_id\"])\n  |> last()\n  |> map(fn: (r) => ({ r with _value: r.station_id + \" - \" + r.station_name + \" \u2014 \" + r.location_name }))\n  |> keep(columns: [\"_value\"])",
        "regex": "/^(?<value>[^ ]+) - (?<text>.*)$/",
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "title": "Freeze Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.station_name} (${__field.labels.location_name})",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 32
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r._field == \"air_temperature\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "High Wind Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "displayName": "${__field.labels.station_name} (${__field.labels.location_name})",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r._field == \"wind_gust\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "High Temperature Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.station_name} (${__field.labels.location_name})",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r._field == \"air_temperature\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "NWS Alert Details",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Minor": {
                        "color": "yellow",
                        "index": 0
                      },
                      "Moderate": {
                        "color": "orange",
                        "index": 1
                      },
                      "Severe": {
                        "color": "red",
                        "index": 2
                      },
                      "Extreme": {
                        "color": "dark-red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "city_name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "urgency"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expires"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"tempest_nws_alerts\")\n  |> filter(fn: (r) => r._field == \"headline\" or r._field == \"urgency\" or r._field == \"expires\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"station_id\", \"event\", \"severity\", \"station_name\", \"location_name\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({ r with city_name: r.station_name + \" (\" + r.location_name + \")\" }))\n  |> keep(columns: [\"city_name\", \"severity\", \"event\", \"urgency\", \"expires\", \"headline\"])",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "city_name": 0,
              "severity": 1,
              "event": 2,
              "urgency": 3,
              "expires": 4,
              "headline": 5
            },
            "excludeByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Station Locations",
      "type": "geomap",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n    |> filter(fn: (r) => r._field == \"latitude\" or r._field == \"longitude\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"station_id\", \"station_name\", \"location_name\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"station_id\", \"station_name\", \"location_name\", \"latitude\", \"longitude\"])",
          "refId": "A"
        }
      ],
      "options": {
        "basemap": {
          "type": "default"
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "view": {
          "id": "coords",
          "lat": 39.8283,
          "lon": -98.5795,
          "zoom": 4
        },
        "layers": [
          {
            "type": "xyz",
            "name": "Precipitation (OpenWeatherMap)",
            "config": {
              "url": "https://tile.openweathermap.org/map/precipitation_new/{z}/{x}/{y}.png?appid=YOUR_OWM_API_KEY",
              "attribution": "Weather data \u00a9 OpenWeatherMap"
            },
            "opacity": 0.6
          },
          {
            "type": "markers",
            "name": "Stations",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 8
                },
                "color": {
                  "fixed": "blue"
                },
                "textConfig": {
                  "fontSize": 12
                }
              },
              "showLegend": false
            },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 1,
      "title": "Air Temperature (feels like / dew point)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "air_temperature"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feels_like"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dew_point"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r.station_id =~ /^${station_id:regex}$/)\n  |> filter(fn: (r) => r._field == \"air_temperature\" or r._field == \"feels_like\" or r._field == \"dew_point\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Relative Humidity",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": []
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r.station_id =~ /^${station_id:regex}$/)\n  |> filter(fn: (r) => r._field == \"relative_humidity\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Wind Speed (avg / gust / lull)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "wind_avg"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "wind_gust"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "wind_lull"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r.station_id =~ /^${station_id:regex}$/)\n  |> filter(fn: (r) => r._field == \"wind_avg\" or r._field == \"wind_gust\" or r._field == \"wind_lull\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Wind Direction",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "min": 0,
          "max": 360,
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": []
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r.station_id =~ /^${station_id:regex}$/)\n  |> filter(fn: (r) => r._field == \"wind_direction\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Station / Sea Level Pressure",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehg",
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "station_pressure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sea_level_pressure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r.station_id =~ /^${station_id:regex}$/)\n  |> filter(fn: (r) => r._field == \"station_pressure\" or r._field == \"sea_level_pressure\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Rain Accumulation (daily)",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthin",
          "displayName": "${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": []
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "import \"timezone\"\n\noption location = timezone.location(name: \"America/Chicago\")\n\nfrom(bucket: \"tempest\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r.station_id =~ /^${station_id:regex}$/)\n  |> filter(fn: (r) => r._field == \"precip\")\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: false)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "UV Index",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "${__field.name} \u00b7 ${__field.labels.station_name} (${__field.labels.location_name})"
        },
        "overrides": []
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"tempest\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tempest_observations\")\n  |> filter(fn: (r) => r.station_id =~ /^${station_id:regex}$/)\n  |> filter(fn: (r) => r._field == \"uv\")\n  |> aggregateWindow(every: 10m, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Solar Radiation / Brightness",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
