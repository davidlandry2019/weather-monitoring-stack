              },
              {
                "color": "red",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen, station_name, location_name,\n       multiIf(\n         v_air >= 80, -42.379 + 2.04901523*v_air + 10.14333127*v_rh - 0.22475541*v_air*v_rh - 0.00683783*v_air*v_air - 0.05481717*v_rh*v_rh + 0.00122874*v_air*v_air*v_rh + 0.00085282*v_air*v_rh*v_rh - 0.00000199*v_air*v_air*v_rh*v_rh + (coalesce(v_solar, 0) / 1000.0) * 8.0,\n         v_air <= 50 AND v_wind >= 3, 35.74 + 0.6215*v_air - 35.75*pow(v_wind, 0.16) + 0.4275*v_air*pow(v_wind, 0.16),\n         v_air) AS feels_like\nFROM (\n  SELECT max(time) AS last_seen, station_id, station_name, location_name,\n         argMaxIf(air_temperature, time, air_temperature IS NOT NULL) AS v_air,\n         argMaxIf(relative_humidity, time, relative_humidity IS NOT NULL) AS v_rh,\n         argMaxIf(wind_avg, time, wind_avg IS NOT NULL) AS v_wind,\n         argMaxIf(solar_radiation, time, solar_radiation IS NOT NULL) AS v_solar\n  FROM ${database}.tempest_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR\n  GROUP BY station_id, station_name, location_name\n  HAVING v_air IS NOT NULL\n)\nORDER BY last_seen"
        }
      ],
      "timeFrom": "1h",
      "hideTimeOverride": true
    },
