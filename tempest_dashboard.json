      "id": 25,
      "title": "Feels Like Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
