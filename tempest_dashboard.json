                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, station_name, location_name, v_wind_avg AS wind_avg, v_wind_gust AS wind_gust, v_wind_lull AS wind_lull\nFROM (\n  SELECT $__timeInterval(time) AS t, station_id, station_name, location_name,\n         avg(wind_avg) AS v_wind_avg,\n avg(wind_gust) AS v_wind_gust,\n avg(wind_lull) AS v_wind_lull\n  FROM ${database}.tempest_observations FINAL\n  WHERE $__timeFilter(time) AND station_id IN (${station_id:singlequote})\n  GROUP BY t, station_id, station_name, location_name\n)\nORDER BY t"
        }
