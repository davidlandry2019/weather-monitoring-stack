          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "-- One series per 2-mile distance bucket (label distance_bucket),\n-- strikes summed per 5 minutes\nSELECT t, distance_bucket, v AS lightning_strike_count\nFROM (\n  SELECT toStartOfInterval(time, INTERVAL 5 MINUTE) AS t,\n         toString(floor(lightning_strike_last_distance / 2) * 2) AS distance_bucket,\n         sum(lightning_strike_count) AS v\n  FROM ${database}.tempest_observations FINAL\n  WHERE $__timeFilter(time) AND station_id IN (${station_id:singlequote})\n    AND lightning_strike_count > 0 AND lightning_strike_last_distance IS NOT NULL\n  GROUP BY t, distance_bucket\n)\nORDER BY t"
        }
      ],
      "description": "Each cell represents a 5-minute time window and a 2-mile distance band. Color brightness shows the total number of lightning strikes detected in that window at that distance - brighter means more strikes, not just that a reading occurred."
