# Copy this file to /etc/tempest-poller.env and fill in real values.
# Keep permissions restrictive: chmod 600 /etc/tempest-poller.env

TEMPEST_TOKEN=your_weatherflow_personal_access_token

# The Tempest REST API always returns raw metric values (Celsius, m/s, hPa, mm)
# regardless of the station's configured display units. "imperial" converts
# these to F/mph/inHg/in at write time; "metric" stores the raw values as-is.
TEMPEST_UNITS=imperial

# Comma-separated list of station IDs to poll, e.g. 123456,789012
# (TEMPEST_STATION_ID, singular, still works as a fallback for one station)
TEMPEST_STATION_IDS=your_station_id

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_api_token
INFLUX_ORG=your_influxdb_org
INFLUX_BUCKET=tempest

POLL_INTERVAL=60

# Manual per-station location name overrides. A station with no entry here
# simply won't have a location_name tag on its points.
# Format: "id:Name;id2:Name2"
STATION_LOCATION_OVERRIDES=123456:Springfield, IL (United States)

# National Weather Service severe weather alerts (Tornado/Severe Thunderstorm/
# Flash Flood Warnings, etc.) for each station's coordinates. Free, no API key.
NWS_ALERTS_ENABLED=true
NWS_POLL_INTERVAL=300
# NWS's API policy requires identifying your application/contact here
NWS_USER_AGENT=tempest-poller/1.0 (your-email@example.com)
