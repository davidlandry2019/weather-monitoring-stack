# Copy this file to /opt/scripts/owm-poller/owm-poller.env and fill in real values.
# Keep permissions restrictive: chmod 600 owm-poller.env

OWM_API_KEY=your_openweathermap_api_key

# Semicolon-separated list of locations, each in OWM's own query format
# ("City,State,Country" for US cities - state code required for US disambiguation)
OWM_LOCATIONS=Denver,CO,US;Miami,FL,US;Seattle,WA,US

# "imperial" (F/mph, default) or "metric" (C/m/s). Note: pressure and
# visibility are always returned in fixed units by OWM regardless of this
# setting - the poller converts those to inHg/miles itself when imperial.
OWM_UNITS=imperial

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_api_token
INFLUX_ORG=your_influxdb_org
# Kept separate from the Tempest bucket - this is arbitrary-location data,
# not your own station's data
INFLUX_BUCKET=weathermap

# OWM's underlying data typically doesn't refresh faster than every
# 10min-1hr regardless of poll frequency, so there's little benefit to
# polling more often than this.
POLL_INTERVAL=300

# National Weather Service severe weather alerts (Tornado/Severe Thunderstorm/
# Flash Flood Warnings, etc.) for each location's coordinates. Free, no API
# key. Works for any US location, not just personal weather stations.
NWS_ALERTS_ENABLED=true
NWS_POLL_INTERVAL=300
# NWS's API policy requires identifying your application/contact here
NWS_USER_AGENT=owm-poller/1.0 (your-email@example.com)
