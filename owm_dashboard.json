          "pluginVersion": "4.0.0",
          "rawSql": "-- Distinct active alert events per location, split by severity\nSELECT concat(city_name, ', ', state, ' (', country, ')') AS place,\n       uniqExactIf(event, severity = 'Minor') AS Minor,\n       uniqExactIf(event, severity = 'Moderate') AS Moderate,\n       uniqExactIf(event, severity = 'Severe') AS Severe,\n       uniqExactIf(event, severity = 'Extreme') AS Extreme\nFROM ${database}.owm_nws_alerts\nWHERE time >= now() - INTERVAL 30 MINUTE\nGROUP BY city_name, state, country\nORDER BY place"
