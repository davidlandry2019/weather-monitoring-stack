{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "ClickHouse",
      "description": "ClickHouse datasource holding the OpenWeatherMap tables",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    },
    {
      "name": "VAR_DATABASE",
      "label": "ClickHouse database",
      "description": "Database the OpenWeatherMap poller writes to (CLICKHOUSE_DATABASE)",
      "type": "constant",
      "value": "weathermap"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "4.0.0"
    },
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": "1.0.0"
    }
  ],
  "title": "OpenWeatherMap Locations",
  "uid": "owm-weathermap",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 36,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "database",
        "label": "ClickHouse database",
        "hide": 2,
        "query": "${VAR_DATABASE}",
        "current": {
          "text": "${VAR_DATABASE}",
          "value": "${VAR_DATABASE}"
        },
        "options": [
          {
            "text": "${VAR_DATABASE}",
            "value": "${VAR_DATABASE}",
            "selected": true
          }
        ],
        "skipUrlSync": false
      },
      {
        "name": "location",
        "label": "Location",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${DS_CLICKHOUSE}"
        },
        "query": "SELECT DISTINCT location FROM ${database}.owm_observations WHERE time >= now() - INTERVAL 30 DAY ORDER BY location",
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "definition": "SELECT DISTINCT location FROM ${database}.owm_observations WHERE time >= now() - INTERVAL 30 DAY ORDER BY location"
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "title": "Freeze Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.city_name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 32
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen, city_name, state, v AS temp\nFROM (\n  SELECT max(time) AS last_seen, location, city_name, state, argMaxIf(temp, time, temp IS NOT NULL) AS v\n  FROM ${database}.owm_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR AND temp IS NOT NULL\n  GROUP BY location, city_name, state\n)\nORDER BY last_seen"
        }
      ]
    },
    {
      "id": 21,
      "title": "High Wind Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "displayName": "${__field.labels.city_name}, ${__field.labels.state}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "-- Gust when it's reported and higher than sustained wind, else sustained\nSELECT last_seen, city_name, state, if(v_gust IS NOT NULL AND v_gust > v_speed, v_gust, v_speed) AS wind\nFROM (\n  SELECT max(time) AS last_seen, location, city_name, state,\n         argMaxIf(wind_speed, time, wind_speed IS NOT NULL) AS v_speed,\n         argMaxIf(wind_gust, time, wind_gust IS NOT NULL) AS v_gust\n  FROM ${database}.owm_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR\n  GROUP BY location, city_name, state\n  HAVING v_speed IS NOT NULL\n)\nORDER BY last_seen"
        }
      ]
    },
    {
      "id": 22,
      "title": "High Temperature Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.city_name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen, city_name, state, v AS temp\nFROM (\n  SELECT max(time) AS last_seen, location, city_name, state, argMaxIf(temp, time, temp IS NOT NULL) AS v\n  FROM ${database}.owm_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR AND temp IS NOT NULL\n  GROUP BY location, city_name, state\n)\nORDER BY last_seen"
        }
      ]
    },
    {
      "id": 1,
      "title": "Location Map",
      "type": "geomap",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT last_seen AS time, location, v_city_name AS city_name, v_lat AS latitude, v_lon AS longitude\nFROM (\n  SELECT location,\n         max(time) AS last_seen,\n         argMax(city_name, time) AS v_city_name,\n         argMaxIf(latitude, time, latitude IS NOT NULL) AS v_lat,\n         argMaxIf(longitude, time, longitude IS NOT NULL) AS v_lon\n  FROM ${database}.owm_observations\n  WHERE time >= now() - INTERVAL 6 HOUR AND latitude IS NOT NULL AND longitude IS NOT NULL\n  GROUP BY location\n)"
        }
      ],
      "options": {
        "basemap": {
          "type": "default"
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "view": {
          "id": "coords",
          "lat": 39.8283,
          "lon": -98.5795,
          "zoom": 4
        },
        "layers": [
          {
            "type": "xyz",
            "name": "Precipitation (OpenWeatherMap)",
            "config": {
              "url": "https://tile.openweathermap.org/map/precipitation_new/{z}/{x}/{y}.png?appid=YOUR_OWM_API_KEY",
              "attribution": "Weather data \u00a9 OpenWeatherMap"
            },
            "opacity": 0.6
          },
          {
            "type": "markers",
            "name": "Locations",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 8
                },
                "color": {
                  "fixed": "blue"
                },
                "textConfig": {
                  "fontSize": 12
                }
              },
              "showLegend": false
            },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Temperature (actual / feels like)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feels_like"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, city_name, state, v_temp AS temp, v_feels_like AS feels_like\nFROM (\n  SELECT $__timeInterval(time) AS t, location, city_name, state,\n         avg(temp) AS v_temp,\n avg(feels_like) AS v_feels_like\n  FROM ${database}.owm_observations FINAL\n  WHERE $__timeFilter(time) AND location IN (${location:singlequote})\n  GROUP BY t, location, city_name, state\n)\nORDER BY t"
        }
      ]
    },
    {
      "id": 3,
      "title": "Humidity",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, city_name, state, v_humidity AS humidity\nFROM (\n  SELECT $__timeInterval(time) AS t, location, city_name, state,\n         avg(humidity) AS v_humidity\n  FROM ${database}.owm_observations FINAL\n  WHERE $__timeFilter(time) AND location IN (${location:singlequote})\n  GROUP BY t, location, city_name, state\n)\nORDER BY t"
        }
      ]
    },
    {
      "id": 4,
      "title": "Wind Speed / Gust",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, city_name, state, v_wind_speed AS wind_speed, v_wind_gust AS wind_gust\nFROM (\n  SELECT $__timeInterval(time) AS t, location, city_name, state,\n         avg(wind_speed) AS v_wind_speed,\n avg(wind_gust) AS v_wind_gust\n  FROM ${database}.owm_observations FINAL\n  WHERE $__timeFilter(time) AND location IN (${location:singlequote})\n  GROUP BY t, location, city_name, state\n)\nORDER BY t"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pressure",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehg",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, city_name, state, v_pressure AS pressure\nFROM (\n  SELECT $__timeInterval(time) AS t, location, city_name, state,\n         avg(pressure) AS v_pressure\n  FROM ${database}.owm_observations FINAL\n  WHERE $__timeFilter(time) AND location IN (${location:singlequote})\n  GROUP BY t, location, city_name, state\n)\nORDER BY t"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cloud Cover",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, city_name, state, v_clouds_all AS clouds_all\nFROM (\n  SELECT $__timeInterval(time) AS t, location, city_name, state,\n         avg(clouds_all) AS v_clouds_all\n  FROM ${database}.owm_observations FINAL\n  WHERE $__timeFilter(time) AND location IN (${location:singlequote})\n  GROUP BY t, location, city_name, state\n)\nORDER BY t"
        }
      ]
    },
    {
      "id": 7,
      "title": "Visibility",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmi",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT t, city_name, state, v_visibility AS visibility\nFROM (\n  SELECT $__timeInterval(time) AS t, location, city_name, state,\n         avg(visibility) AS v_visibility\n  FROM ${database}.owm_observations FINAL\n  WHERE $__timeFilter(time) AND location IN (${location:singlequote})\n  GROUP BY t, location, city_name, state\n)\nORDER BY t"
        }
      ]
    },
    {
      "id": 8,
      "title": "Current Conditions",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 41
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT v_city_name AS city_name, v_main AS weather_main, v_desc AS weather_description,\n       v_temp AS temp, v_humidity AS humidity\nFROM (\n  SELECT location,\n         argMax(city_name, time) AS v_city_name,\n         argMaxIf(weather_main, time, weather_main != '') AS v_main,\n         argMaxIf(weather_description, time, weather_description != '') AS v_desc,\n         argMaxIf(temp, time, temp IS NOT NULL) AS v_temp,\n         argMaxIf(humidity, time, humidity IS NOT NULL) AS v_humidity\n  FROM ${database}.owm_observations FINAL\n  WHERE time >= now() - INTERVAL 1 HOUR AND location IN (${location:singlequote})\n  GROUP BY location\n)\nORDER BY city_name"
        }
      ]
    },
    {
      "id": 24,
      "title": "NWS Alert Details",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
