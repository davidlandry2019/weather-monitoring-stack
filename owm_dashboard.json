{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB datasource pointing at your weathermap bucket",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": "1.0.0"
    }
  ],
  "title": "OpenWeatherMap Locations",
  "uid": "owm-weathermap",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 36,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "location",
        "label": "Location",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUXDB}"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"weathermap\", tag: \"location\")",
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "title": "Freeze Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.city_name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 32
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r._field == \"temp\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "High Wind Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "displayName": "${__field.labels.city_name}, ${__field.labels.state}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r._field == \"wind_speed\" or r._field == \"wind_gust\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"location\", \"city_name\", \"state\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ r with wind: if exists r.wind_gust and r.wind_gust > r.wind_speed then r.wind_gust else r.wind_speed }))\n  |> keep(columns: [\"city_name\", \"state\", \"wind\"])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "High Temperature Warning",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.labels.city_name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r._field == \"temp\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "title": "Location Map",
      "type": "geomap",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n    |> filter(fn: (r) => r._field == \"latitude\" or r._field == \"longitude\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"location\", \"city_name\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"location\", \"city_name\", \"latitude\", \"longitude\"])",
          "refId": "A"
        }
      ],
      "options": {
        "basemap": {
          "type": "default"
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "view": {
          "id": "coords",
          "lat": 39.8283,
          "lon": -98.5795,
          "zoom": 4
        },
        "layers": [
          {
            "type": "xyz",
            "name": "Precipitation (OpenWeatherMap)",
            "config": {
              "url": "https://tile.openweathermap.org/map/precipitation_new/{z}/{x}/{y}.png?appid=YOUR_OWM_API_KEY",
              "attribution": "Weather data \u00a9 OpenWeatherMap"
            },
            "opacity": 0.6
          },
          {
            "type": "markers",
            "name": "Locations",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 8
                },
                "color": {
                  "fixed": "blue"
                },
                "textConfig": {
                  "fontSize": 12
                }
              },
              "showLegend": false
            },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Temperature (actual / feels like)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feels_like"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => r._field == \"temp\" or r._field == \"feels_like\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Humidity",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => r._field == \"humidity\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Wind Speed / Gust",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => r._field == \"wind_speed\" or r._field == \"wind_gust\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pressure",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehg",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => r._field == \"pressure\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cloud Cover",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => r._field == \"clouds_all\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Visibility",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmi",
          "displayName": "${__field.name} - ${__field.labels.city_name}, ${__field.labels.state}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => r._field == \"visibility\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Current Conditions",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 41
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"owm_observations\")\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => r._field == \"temp\" or r._field == \"humidity\" or r._field == \"weather_main\" or r._field == \"weather_description\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"location\", \"city_name\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"city_name\", \"weather_main\", \"weather_description\", \"temp\", \"humidity\"])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "NWS Alert Details",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Minor": {
                        "color": "yellow",
                        "index": 0
                      },
                      "Moderate": {
                        "color": "orange",
                        "index": 1
                      },
                      "Severe": {
                        "color": "red",
                        "index": 2
                      },
                      "Extreme": {
                        "color": "dark-red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "city_name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "urgency"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expires"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "query": "from(bucket: \"weathermap\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"owm_nws_alerts\")\n  |> filter(fn: (r) => r._field == \"headline\" or r._field == \"urgency\" or r._field == \"expires\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"location\", \"event\", \"severity\", \"city_name\", \"state\", \"country\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({ r with city_name: r.city_name + \", \" + r.state + \" (\" + r.country + \")\" }))\n  |> keep(columns: [\"city_name\", \"severity\", \"event\", \"urgency\", \"expires\", \"headline\"])",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "city_name": 0,
              "severity": 1,
              "event": 2,
              "urgency": 3,
              "expires": 4,
              "headline": 5
            },
            "excludeByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
