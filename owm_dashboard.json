          "queryType": "table",
          "pluginVersion": "4.0.0",
          "rawSql": "SELECT concat(v_city, ', ', v_state, ' (', v_country, ')') AS city_name,\n       severity, event, v_urgency AS urgency, v_expires AS expires, v_headline AS headline\nFROM (\n  SELECT location, city_name AS v_city, state AS v_state, country AS v_country, event, severity,\n         argMax(urgency, time) AS v_urgency,\n         argMax(expires, time) AS v_expires,\n         argMax(headline, time) AS v_headline\n  FROM ${database}.owm_nws_alerts\n  WHERE time >= now() - INTERVAL 30 MINUTE\n  GROUP BY location, v_city, v_state, v_country, event, severity\n)\nORDER BY city_name, event"
        }
